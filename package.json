{
  "name": "mixxx-phone-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Control Mixxx from your phone's browser over Wi-Fi to practice transitions with your own library.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "demo": "node --disable-warning=ExperimentalWarning server.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@julusian/midi": "^3.6.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  }
}
